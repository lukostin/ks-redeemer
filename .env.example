# KS REDEEMER Configuration

# Optional: Vercel Cron Secret to protect /api/cron/redeem from unauthorized external calls
# Set this in your Vercel Project Settings > Environment Variables
CRON_SECRET=your_secure_cron_secret_here

# Optional: Next Public App URL (defaults to automatic Vercel URL or http://localhost:3000)
NEXT_PUBLIC_APP_URL=http://localhost:3000
